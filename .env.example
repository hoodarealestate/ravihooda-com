# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

PROPTX_IDX_TOKEN=your_idx_token_here
PROPTX_VOW_TOKEN=your_vow_token_here
PROPTX_DLA_TOKEN=your_dla_token_here
PROPTX_ENDPOINT=https://query.ampre.ca/odata/

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=you@yourdomain.com
RESEND_FROM_NAME=The Hooda Team

NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

CRM_ADMIN_EMAIL=admin@ravihooda.com
CRM_ADMIN_PASSWORD=change_this_password
CRM_JWT_SECRET=generate_a_random_secret_here

VOW_JWT_SECRET=generate_another_random_secret_here

NEXT_PUBLIC_SITE_URL=https://ravihooda.com

# Supabase — real database for CRM contacts, campaigns, unsubscribes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — update after verifying ravihooda.com domain in Resend dashboard
# Change RESEND_FROM_EMAIL to ravi@ravihooda.com after domain verification
BREVO_API_KEY=xkeysib-...
