{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "home-sale.ca" }],
      "destination": "https://ravihooda.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.home-sale.ca" }],
      "destination": "https://ravihooda.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mlssale.ca" }],
      "destination": "https://ravihooda.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mlssale.ca" }],
      "destination": "https://ravihooda.com/:path*",
      "permanent": true
    },
    {
      "source": "/node/add/dream_home/lead_form_view",
      "destination": "/dream-home",
      "permanent": true
    },
    {
      "source": "/node/add/dream_home/:path*",
      "destination": "/dream-home",
      "permanent": true
    },
    {
      "source": "/node/add/:path*",
      "destination": "/dream-home",
      "permanent": true
    },
    {
      "source": "/node/:path*",
      "destination": "/dream-home",
      "permanent": true
    },
    {
      "source": "/landing/whats-my-home-worth",
      "destination": "/home-value",
      "permanent": true
    },
    {
      "source": "/landing/:path*",
      "destination": "/home-value",
      "permanent": true
    },
    {
      "source": "/home-evaluation",
      "destination": "/home-value",
      "permanent": true
    }
  ]
}
